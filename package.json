{
  "name": "larria-car-drive-3d",
  "private": true,
  "version": "1.2.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "test:settings": "playwright test --config tests/settings-controls.config.mjs",
    "test:pwa": "playwright test --config tests/pwa.config.mjs",
    "test:browser:all": "npm run test:e2e && npm run test:settings && npm run test:pwa",
    "deploy": "npm run build && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
}
